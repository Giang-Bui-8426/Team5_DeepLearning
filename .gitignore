# Model-specific HTML reports: keep only the aggregate training HTML
# (and unrelated HTML such as an EDA report, if present).
**/reports/*/report.html

# Checkpoints: ignore all contents except each model's best
# and the global best used by Predict.py.
**/checkpoints/**/*
!**/checkpoints/**/checkpoint_best_global.pt

