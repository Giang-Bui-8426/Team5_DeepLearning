digraph TrainingWorkflow {
  graph [rankdir=TB, bgcolor="transparent", pad="0.25", nodesep="0.34", ranksep="0.42", splines=polyline, fontname="DejaVu Sans", dpi=155];
  node [shape=box, style="rounded,filled", color="#D8E2F1", fillcolor="#F6F9FD", fontcolor="#1C324D", fontname="DejaVu Sans", fontsize=14, penwidth=1.3, margin="0.24,0.16"];
  edge [color="#7B8DAA", arrowsize=0.8, penwidth=1.4, fontname="DejaVu Sans", fontsize=11, fontcolor="#536881"];

  data [label="01 · DỮ LIỆU\nTrain DataLoader · Validation DataLoader", fillcolor="#EAF0FB"];
  setup [label="02 · THÍ NGHIỆM\nModel + AdamW + CrossEntropy + Scheduler", fillcolor="#EAF0FB"];
  batch [label="03 · HUẤN LUYỆN MỖI BATCH\nForward → Loss → Backward\nClip gradient (5.0) → Optimizer step", fillcolor="#E3F4EE", color="#9DCCB9"];
  validation [label="04 · VALIDATION MỖI EPOCH\nLoss · Accuracy · Precision · Recall · F1 · FPR · AUC", fillcolor="#E3F4EE", color="#9DCCB9"];
  stop [label="05 · EARLY STOPPING\nValidation loss không cải thiện 5 epoch?", shape=diamond, fillcolor="#FFF2D9", color="#E5C891", margin="0.1,0.08", fontsize=13];
  save [label="06 · LOG VÀ LƯU TRẠNG THÁI\nTensorBoard · Scheduler step\nBest checkpoint theo accuracy · Last checkpoint", fillcolor="#EAF0FB"];
  next [label="Epoch tiếp theo", fillcolor="#F9FAFD", fontsize=12];
  done [label="07 · TỔNG HỢP 6 MODEL\nCSV · Biểu đồ · Chọn global best checkpoint", fillcolor="#DFEAFB", color="#A5BFE6"];

  data -> setup -> batch -> validation -> stop;
  stop -> save [label="Chưa dừng"];
  save -> next [label="Chưa đủ epoch"];
  next -> batch [constraint=false];
  stop -> done [label="Đủ patience", color="#B78644", fontcolor="#966B2A"];
  save -> done [label="Hết epochs", color="#7B8DAA"];
}
