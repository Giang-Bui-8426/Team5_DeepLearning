digraph training_workflow {
  rankdir=TB;
  node [shape=box, style="rounded,filled", fontname="DejaVu Sans"];
  phase0 [label="Đọc Config_parameter, split và seed\nDùng cùng dữ liệu / preprocessing", fillcolor="#E6F0FF"];
  phase1 [label="ImageNet → head 10 lớp\nĐóng băng backbone", fillcolor="#E6F0FF"];
  phase2 [label="Giai đoạn 1 · train head\nChỉ head nhận cập nhật", fillcolor="#DEF5E9"];
  phase3 [label="Validation → chọn best FE\nLưu checkpoint của run 01 / 03 / 05", fillcolor="#E6F0FF"];
  phase4 [label="Load toàn bộ best checkpoint FE\nGiữ backbone + head đã học", fillcolor="#E6F0FF"];
  phase5 [label="Mở stage cuối + tạo optimizer mới\nLR head / backbone theo cấu hình", fillcolor="#FFF0CD"];
  phase6 [label="Giai đoạn 2 · fine-tune tiếp\nHead + stage cuối nhận cập nhật", fillcolor="#FFF0CD"];
  phase7 [label="Validation → lưu best fine-tune\nCheckpoint riêng run 02 / 04 / 06", fillcolor="#DEF5E9"];
  phase8 [label="So sánh 6 run → CSV + một HTML offline\nreports/report_all_models.html", fillcolor="#E6F0FF"];
  epoch0 [label="model.train()\nDuy trì policy BatchNorm / Dropout", fillcolor="#FFFFFF"];
  epoch1 [label="Forward → CrossEntropyLoss\nzero_grad → autocast nếu CUDA", fillcolor="#FFFFFF"];
  epoch2 [label="Backward → clip → optimizer step\nAMP: unscale trước clipping", fillcolor="#FFFFFF"];
  epoch3 [label="model.eval() → validation 5.000 ảnh\ninference_mode · không augmentation", fillcolor="#FFFFFF"];
  epoch4 [label="Ghi metrics, thời gian, bộ nhớ\nTensorBoard + history theo epoch", fillcolor="#FFFFFF"];
  epoch5 [label="Scheduler → lưu best / last → xét dừng\nEpoch cuối vẫn được lưu đầy đủ", fillcolor="#E6F0FF"];
  resume [label="Resume cùng run từ last_checkpoint.pt\nKhôi phục model + optimizer/scheduler/scaler\n+ epoch, RNG và trạng thái dừng sớm", fillcolor="#E6F0FF"];
  phase0 -> phase1;
  phase1 -> phase2;
  phase2 -> phase3;
  phase3 -> phase4;
  phase4 -> phase5;
  phase5 -> phase6;
  phase6 -> phase7;
  phase7 -> phase8;
  epoch0 -> epoch1;
  epoch1 -> epoch2;
  epoch2 -> epoch3;
  epoch3 -> epoch4;
  epoch4 -> epoch5;
  epoch5 -> epoch0 [style=dashed];
}
