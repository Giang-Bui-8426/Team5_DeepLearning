digraph block {
 rankdir=LR;

 graph [fontname="DejaVu Sans", bgcolor="#FFFFFF", pad="0.26", nodesep="0.34", ranksep="0.54", splines=ortho, outputorder=edgesfirst];
 node [shape=box, style="rounded,filled", penwidth=1.2, fontname="DejaVu Sans", fontsize=12, margin="0.22,0.20", color="#CFD8E3", fillcolor="#F7F9FC", fontcolor="#14263E"];
 edge [fontname="DejaVu Sans", color="#7E92A8", penwidth=2, arrowsize=0.65];

 node [fontsize=12];
 x [label="x\n[B, 512]", fillcolor="#EDF3FF", color="#8FAFF2"];
 ln [label="LayerNorm\n512", fillcolor="#F1EEFB", color="#B5A3DD"];
 fc1 [label="Linear\n512 → 1024", fillcolor="#E9F5F7", color="#79BDCA"];
 gelu [label="GELU\n[B, 1024]", fillcolor="#E9F5F7", color="#79BDCA"];
 fc2 [label="Linear\n1024 → 512", fillcolor="#E9F5F7", color="#79BDCA"];
 drop [label="Dropout\np = 0.2", fillcolor="#F1EEFB", color="#B5A3DD"];
 sum [label="+", shape=circle, width=0.56, fixedsize=true, fillcolor="#FFF4E6", color="#E8B56D", fontsize=22];
 y [label="y = x + F(x)\n[B, 512]", fillcolor="#EBF8ED", color="#8EC49B"];
 x -> ln -> fc1 -> gelu -> fc2 -> drop -> sum -> y;
 x -> sum [label="skip / identity", color="#2E88B1", fontcolor="#2E88B1", constraint=false, penwidth=2.4];
}
