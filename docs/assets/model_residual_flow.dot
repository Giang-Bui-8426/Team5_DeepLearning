digraph residual {
 rankdir=LR;

 graph [fontname="DejaVu Sans", bgcolor="#FFFFFF", pad="0.26", nodesep="0.34", ranksep="0.54", splines=ortho, outputorder=edgesfirst];
 node [shape=box, style="rounded,filled", penwidth=1.2, fontname="DejaVu Sans", fontsize=12, margin="0.22,0.20", color="#CFD8E3", fillcolor="#F7F9FC", fontcolor="#14263E"];
 edge [fontname="DejaVu Sans", color="#7E92A8", penwidth=2, arrowsize=0.65];

 input [label="Ảnh đầu vào\n[B, 1, 28, 28]", fillcolor="#EDF3FF", color="#8FAFF2"];
 flat [label="Flatten\n[B, 784]", fillcolor="#EDF3FF", color="#8FAFF2"];
 fc1 [label="FC1\n784 → 256\nLayerNorm · GELU", fillcolor="#E9F5F7", color="#79BDCA"];
 fc2 [label="FC2\n256 → 512\nLayerNorm · GELU\nDropout 0.2", fillcolor="#E9F5F7", color="#79BDCA"];
 rb [label="2 × ResidualBlock\n512 → 1024 → 512\nKết nối tắt x + F(x)", fillcolor="#FFF4E6", color="#E8B56D", penwidth=2];
 lastnorm [label="LayerNorm\n[B, 512]", fillcolor="#F1EEFB", color="#B5A3DD"];
 fc4 [label="FC4\n512 → 256\nLayerNorm · GELU", fillcolor="#E9F5F7", color="#79BDCA"];
 fc5 [label="FC5\n256 → 10", fillcolor="#FFF4E6", color="#F0BB7B"];
 output [label="LOGITS\n[B, 10]", fillcolor="#EBF8ED", color="#8EC49B"];
 input -> flat -> fc1 -> fc2 -> rb -> lastnorm -> fc4 -> fc5 -> output;
}
